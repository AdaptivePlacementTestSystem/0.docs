@startuml PlacementTestClassModel
' Sinh tu dong tu TLCN.drawio.xml (3 trang, ban gon 26-27/10/2026) bang Tuan7/scripts/gen_uml.py. KHONG sua tay: sua drawio roi sinh lai.
' Khong ve: ExamRoundParticipant, ItemBatchAssignment, ItemReviewAssignment, ItemEmbedding (bang luu tru, xem schema.prisma).
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam class {
  BackgroundColor White
  ArrowColor #33459C
  BorderColor #33459C
}

' ===== Người dùng & kỳ thi =====
abstract class User {
  - id: UUID
  - email: String
  - fullName: String
  - role: UserRole
  + hasRole(role: UserRole): boolean
}
class Student {
  - studentCode: String
  + getLatestProfile(): LanguageProfile
}
class Teacher {
  - teacherCode: String
  + reviewItem(item, action): void
  + submitPackage(pkg): void
}
class Admin {
  + createItemBatch(src): ItemBatch
  + importBatch(batch): void
  + createExamRound(): ExamRound
}
class ExamRound {
  - id: UUID
  - name: String
  - durationMinutes: int = 45
  - status: ExamRoundStatus
  - opensAt: DateTime
  - closesAt: DateTime
  + isOpen(at: DateTime): boolean
  + includesStudent(id: UUID): boolean
  + registerStudent(s: Student): void
}

' ===== Phiên thi & CAT =====
class TestSession {
  - id: UUID
  - student: Student
  - examRound: ExamRound
  - status: SessionStatus
  - thetaFinal: float?
  - seFinal: float?
  - stoppingReason: StoppingReason?
  - startedAt: DateTime
  - completedAt: DateTime?
  - expiresAt: DateTime
  + submitAnswer(itemId, ans): SessionResponse
  + computeResult(): LanguageProfile
  + terminate(reason): void
}
class SessionResponse {
  - id: UUID
  - response: char
  - isCorrect: boolean
  - thetaAfter: float
  - seAfter: float
  - responseTimeMs: int
  - answeredAt: DateTime
}
class SessionCacheState <<Redis>> {
  - state: SessionState
  - currentItemId: UUID
  - eapState: EAPComputationState
  - lastSkillPicked: Skill
  - itemsAdministered: UUID[]
  - lastUpdated: DateTime
  - ttlSeconds: int = 7200
  + reconstructFromDB(): void
}
class EAPComputationState <<value object>> {
  - posteriorWeights: float[41]
  - theta: float
  - standardError: float
}
class CATEngine <<service>> {
  + pickNextSkill(cache): Skill
  + selectNextItem(cache, pool): Item
  + computeEAP(responses[]): AbilityEstimate
  + checkStoppingCriterion(cache): StoppingReason
}
class AbilityEstimate <<value object>> {
  - theta: float
  - standardError: float
  - confidenceInterval95: float[]
}

' ===== Hồ sơ năng lực =====
class LanguageProfile <<aggregate root>> {
  - id: UUID
  - abilityEstimate: AbilityEstimate
  - completedAt: DateTime
  - cefrLevel: CEFRLevel
  - cefrConfidence: CEFRConfidence
  - boundaryEffect: boolean
  - skillProfiles: List
  - errorPatterns: List
  - aiRecommendations: String[]
  + generateFromSession(s): void
  + exportForEduZ(): String
}
class SkillProfile <<value object>> {
  - skill: Skill
  - scorePercent: float
  - cefrEstimate: CEFRLevel
  - itemsAdministered: int
  - correctCount: int
}
class ErrorPattern <<value object>> {
  - topicTag: String
  - skill: Skill
  - itemsAttempted: int
  - correctCount: int
  - accuracyRate: float
  - /severity: String
}
class TestMetadata <<value object>> {
  - itemsAdministered: int
  - testDurationSeconds: int
  - algorithm: String = "EAP-41"
  - stoppingReason: StoppingReason
}

' ===== Ngân hàng câu hỏi & duyệt =====
class Item {
  - id: UUID
  - content: String
  - options: Json
  - correctAnswer: char
  - skill: Skill
  - topicTag: String?
  - cefrTarget: CEFRLevel
  - irtB: float
  - irtA: float = 1.0 {Rasch}
  - status: ItemStatus
  + probability(theta: float): float
  + fisherInformation(theta): float
  + transitionTo(next: ItemStatus): void
}
class Explanation {
  - id: UUID
  - generatedAt: DateTime
  - content: String
}
class ItemCheckResult {
  - checkpoint: CheckPoint
  - level: CheckLevel
  - checkedAt: DateTime
  - suspectedDuplicateId: UUID
  - reasonCodes: String[]
  + isPassed(): boolean
}
class ItemBatch {
  - id: UUID
  - name: String
  - source: ItemBatchSource
  - status: ItemBatchStatus
  + transitionTo(next): void
  + canAssign(): boolean
  + canFinalize(): boolean
}
class ItemPackage {
  - id: UUID
  - reviewerId: UUID
  - confirmerId: UUID
  - status: PackageStatus
  - dueAt: DateTime?
  - sentAt: DateTime?
  + canSend(): boolean
  + isOverdue(at): boolean
}
class ItemReviewEvent {
  - id: UUID
  - itemId: UUID?
  - batchId: UUID
  - actorId: UUID
  - action: ReviewAction
  - createdAt: DateTime
}

' ===== Enum =====
enum CEFRConfidence {
  HIGH
  MEDIUM
  LOW
}
enum CEFRLevel {
  PRE_A1
  A1
  A2
  B1
  B2
  C1_PLUS
}
enum CheckLevel {
  PASS
  SOFT
  HARD
}
enum CheckPoint {
  C1
  C2
  C3
}
enum ExamRoundStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
}
enum ItemBatchSource {
  AI_GENERATED
  IMPORTED
}
enum ItemBatchStatus {
  GENERATING
  IMPORTING
  CHECKING
  READY_TO_ASSIGN
  IN_REVIEW
  READY_TO_FINALIZE
  FINAL_CHECKED
  DONE
  FAILED
  PARTIAL
}
enum ItemStatus {
  DRAFT
  FIRST_APPROVED
  SECOND_APPROVED
  FINAL_APPROVED
  REJECTED
  AI_REJECTED
}
enum PackageStatus {
  OPEN
  SENT
  DONE
}
enum ReviewAction {
  APPROVE
  REJECT
  CONFIRM
  REMOVE
  CONFIRM_ALL
  IMPORT
  REASSIGN
  EXTEND
  FORCE_SEND
  ACCEPT_FLAG
}
enum SessionState {
  WAITING_FOR_ANSWER
  READY_FOR_NEXT
}
enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
enum Skill {
  VOCABULARY
  GRAMMAR
}
enum StoppingReason {
  MAX_ITEMS_REACHED
  SE_THRESHOLD
  ITEM_BANK_BOUNDARY
  TIMEOUT
}
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

' ===== Quan he =====
User <|-- Student
User <|-- Teacher
User <|-- Admin
ExamRound "0..*" -- "0..*" Student : registered
ExamRound "1" --> "0..*" TestSession
Student "1" --> "0..*" TestSession
Admin --> ExamRound : creates
TestSession "1" *-- "1..*" SessionResponse
SessionResponse "0..*" --> "1" Item
TestSession ..> SessionCacheState : use
SessionCacheState "1" *-- "1" EAPComputationState
CATEngine ..> AbilityEstimate : compute
CATEngine ..> Item : select
CATEngine ..> SessionCacheState : use
TestSession "1" --> "0..1" LanguageProfile
Student "1" --> "0..*" LanguageProfile
LanguageProfile "1" *-- "1" AbilityEstimate
LanguageProfile "1" *-- "1..*" SkillProfile
LanguageProfile "1" *-- "0..*" ErrorPattern
LanguageProfile "1" *-- "1" TestMetadata
Item "1" *-- "0..1" Explanation
Item "1" *-- "0..*" ItemCheckResult
ItemBatch "1" *-- "1..*" Item
ItemBatch "1" *-- "1..*" ItemPackage
ItemPackage "0..1" --> "0..*" Item
ItemPackage "0..1" --> "0..*" ItemReviewEvent
Item "0..1" --> "0..*" ItemReviewEvent
Admin --> ItemBatch : creates
Teacher --> ItemPackage : reviews
@enduml
