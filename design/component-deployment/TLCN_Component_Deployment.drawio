e="&amp;lt;&amp;lt;HTTP&amp;gt;&amp;gt;" edge="1" source="dep-23" target="dep-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-51" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;HTTP&amp;gt;&amp;gt;" edge="1" source="dep-23" target="dep-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-52" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;HTTP (BFF → REST)&amp;gt;&amp;gt;" edge="1" source="dep-26" target="dep-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-53" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;TCP / SQL&amp;gt;&amp;gt;" edge="1" source="dep-29" target="dep-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-54" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;TCP / RESP&amp;gt;&amp;gt;" edge="1" source="dep-29" target="dep-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-55" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;HTTPS&amp;gt;&amp;gt;" edge="1" source="dep-29" target="dep-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-56" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;dashed=1;" value="&amp;lt;&amp;lt;SMTP&amp;gt;&amp;gt;" edge="1" source="dep-29" target="dep-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-57" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;HTTPS&amp;gt;&amp;gt; log" edge="1" source="dep-37" target="dep-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-58" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;dashed=1;" value="&amp;lt;&amp;lt;HTTPS :8443&amp;gt;&amp;gt; GET /api/health" edge="1" source="dep-44" target="dep-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-59" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;git push / PR&amp;gt;&amp;gt;" edge="1" source="dep-8" target="dep-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-60" parent="1" style="endArrow=none;html=1;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" value="&amp;lt;&amp;lt;push image&amp;gt;&amp;gt;" edge="1" source="dep-14" target="dep-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-61" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#1f2937;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;" value="&amp;lt;&amp;lt;deploy&amp;gt;&amp;gt; SSH → deploy.sh" edge="1" source="dep-14" target="dep-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="1060"/></Array></mxGeometry></mxCell><mxCell id="dep-62" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#1f2937;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelBackgroundColor=#ffffff;" value="&amp;lt;&amp;lt;pull image&amp;gt;&amp;gt;" edge="1" source="dep-22" target="dep-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="1070"/></Array></mxGeometry></mxCell><mxCell id="dep-63" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontFamily=Helvetica;fontColor=#1f2937;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Chú giải (UML 2.0 — PDF mục XV)&lt;/b&gt;&lt;br&gt;• Hình hộp (cube) = &lt;b&gt;node&lt;/b&gt;: &amp;lt;&amp;lt;device&amp;gt;&amp;gt; phần cứng; &amp;lt;&amp;lt;executionEnvironment&amp;gt;&amp;gt; môi trường thực thi (container, Docker, GitHub…).&lt;br&gt;• &lt;b&gt;name : type&lt;/b&gt; = thể hiện của node (vd. &lt;i&gt;staging : Linux Server&lt;/i&gt;).&lt;br&gt;• Hình tài liệu (note) = &lt;b&gt;artifact&lt;/b&gt; đặt trong node nghĩa là được triển khai lên node đó; nền vàng = &amp;lt;&amp;lt;deployment spec&amp;gt;&amp;gt; (tham số triển khai: .env, nginx.conf, compose…).&lt;br&gt;• Đường liền có nhãn &amp;lt;&amp;lt;giao thức&amp;gt;&amp;gt; = kết nối giữa node. Mũi tên đứt &amp;lt;&amp;lt;deploy&amp;gt;&amp;gt; = triển khai artifact lên node.&lt;br&gt;• Nền xám = hệ thống ngoài / không thuộc nhóm. Viền đứt nét = chưa chốt.&lt;br&gt;&lt;br&gt;&lt;b&gt;Điểm cần lưu ý&lt;/b&gt;&lt;br&gt;• Chỉ cổng &lt;b&gt;8443&lt;/b&gt; mở ra Internet; backend/Postgres/Redis không publish cổng (Docker bỏ qua UFW).&lt;br&gt;• NFR (SRS 15.1) hướng tới Nginx + &lt;b&gt;2 instance&lt;/b&gt; NestJS cho 100 user; staging hiện chạy 1 backend.&lt;br&gt;• Postgres/Redis là container (#65), không dịch vụ quản lý.&lt;br&gt;• Mailpit chỉ có ở môi trường dev (máy lập trình viên), không có trên staging." vertex="1"><mxGeometry x="1480" y="1100" width="1000" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
