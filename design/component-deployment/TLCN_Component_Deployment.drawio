ometry x="86" y="6" width="18" height="14" as="geometry"/></mxCell><mxCell id="cmp-140" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;" value="Component (icon góc phải trên); &amp;lt;&amp;lt;subsystem&amp;gt;&amp;gt; = component đặc biệt (khung lớn)" vertex="1"><mxGeometry x="2192" y="80" width="380" height="36" as="geometry"/></mxCell><mxCell id="cmp-141" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;labelPosition=center;align=center;spacingBottom=2;" value="" vertex="1"><mxGeometry x="2090" y="148" width="14" height="14" as="geometry"/></mxCell><mxCell id="cmp-142" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;" value="Provided interface (ball) ⟷ Required interface (socket, nửa vòng tròn): lắp ráp ball-and-socket" vertex="1"><mxGeometry x="2120" y="138" width="450" height="34" as="geometry"/></mxCell><mxCell id="cmp-143" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;" value="" vertex="1"><mxGeometry x="2090" y="183" width="14" height="14" as="geometry"/></mxCell><mxCell id="cmp-144" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;" value="Port (ô vuông trên biên) + delegation connector (mũi tên liền) vào thành phần bên trong" vertex="1"><mxGeometry x="2120" y="174" width="450" height="30" as="geometry"/></mxCell><mxCell id="cmp-145" parent="1" style="text;html=1;" value="" vertex="1"><mxGeometry x="2084" y="224" width="28" height="4" as="geometry"/></mxCell><mxCell id="cmp-146" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#1f2937;" value="Mũi tên đứt nét = dependency (requires). Khung đứt nét = tùy chọn / đề xuất / ngoài phạm vi TL" vertex="1"><mxGeometry x="2120" y="210" width="450" height="40" as="geometry"/></mxCell><mxCell id="cmp-147" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#9ca3af;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontColor=#1f2937;" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• 13 module khớp &lt;i&gt;app.module.ts&lt;/i&gt;; tên interface lấy từ tài liệu/mã (MailPort, LlmProviderPort, ItemRepository, CATEngine…).&lt;br&gt;• Mỗi module truy cập DB qua Repository (Prisma) — vẽ gộp theo nhóm vào khối Infrastructure.&lt;br&gt;• CAT chỉ chọn Item &lt;i&gt;FINAL_APPROVED&lt;/i&gt; (lọc ở Repository).&lt;br&gt;• Không còn Institution / EduZ SSO (đơn trường, DC-19)." vertex="1"><mxGeometry x="1850" y="1210" width="560" height="150" as="geometry"/></mxCell><mxCell id="cmp-148" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffeaea;strokeColor=#9ca3af;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fontFamily=Helvetica;fontColor=#1f2937;" value="&lt;b&gt;Chưa khớp mã (nợ đồng bộ)&lt;/b&gt;&lt;br&gt;• &lt;i&gt;ai-explainer&lt;/i&gt; hiện có gemini-flash.provider riêng; thiết kế đích gọi qua llm-gateway.&lt;br&gt;• bullmq / nodemailer chưa có trong package.json backend.&lt;br&gt;• Nginx: luật định tuyến chi tiết chưa chốt trong tài liệu." vertex="1"><mxGeometry x="1850" y="1380" width="560" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Deployment Diagram" id="dep"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2800" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dep-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2937;" value="&lt;b style='font-size:18px'&gt;Deployment Diagram